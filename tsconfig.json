{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["core/src", "providers/*/firmware", "providers/*/server", "providers/*/tests", "providers/*/routes.ts"],
  "exclude": ["**/sw-entry.ts", "core/src/swRuntime.ts"]
}
